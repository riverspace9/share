  "schemas": {
    "FevFlowerOrderItems": {
      "columns": [
        "flower_order_item_id",
        "flower_order_id",
        "line_no_snapshot",
        "item_code_snapshot",
        "item_name_snapshot",
        "unit_snapshot",
        "quantity_snapshot",
        "inventory_stock_id",
