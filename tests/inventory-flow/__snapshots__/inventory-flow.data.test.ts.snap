      "includeItemName": true,
      "role": "출고 품목. 사용수량은 CONSUME 전표의 이 행을 합산한다",
      "section": "출고 전표",
    },
    "InventoryIssues": {
      "columns": [
        "issue_id",
        "company_id",
        "issue_type",
        "status",
        "issued_at",
      ],
      "group": "재고",
      "role": "출고 전표. 회사에서 재고가 나간 사실을 기록한다",
